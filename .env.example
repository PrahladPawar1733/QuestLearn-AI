# ---------------------------------------------------------------
# QuestLearn AI configuration. Copy to .env.local for local dev.
# With nothing set, the app runs in DEMO MODE (no AI calls,
# local JSON storage, prepared demo quest only).
# ---------------------------------------------------------------

# --- Gemini on Vertex AI (recommended) ---
# Auth uses Application Default Credentials:
#   local:      gcloud auth application-default login
#   Cloud Run:  the service account attached to the service
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us
# Gemini 2.5 models retire on Vertex AI on 2026-10-20; 3.5 Flash is stable until at least 2027-05.
GEMINI_MODEL=gemini-3.5-flash
# Optional separate model for the independent-solve question reviewer
# GEMINI_REVIEW_MODEL=gemini-3.5-flash

# --- Alternative: Gemini API key (Google AI Studio) instead of Vertex AI ---
# GEMINI_API_KEY=

# --- Persistence (production) ---
# QL_DB=firestore
# FIRESTORE_DATABASE=(default)
# FIRESTORE_PREFIX=ql_
# GCS_BUCKET=your-private-bucket

# --- Optional: Veo teaching videos (needs Vertex AI + GCS_BUCKET + Veo access) ---
# QL_ENABLE_VIDEO=true
# VEO_MODEL=<a Veo model id enabled in your project>

# --- Misc ---
# QL_FORCE_DEMO=true          # force demo mode even when credentials exist
# QL_AI_TIMEOUT_MS=90000
# QL_DATA_DIR=.data           # local store + uploads when not using Firestore/GCS
